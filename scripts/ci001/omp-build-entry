#!/bin/sh
# Forced command for the dedicated stronk-omp Linux amd64 build key on ci-001.
# Main installs this one standalone file root-owned, mode 0755; see docs/ci001-build-door.md.
#
# SSH_ORIGINAL_COMMAND is matched in full against exactly one of these and never evaluated by a shell:
#   build <app-40hex> <recipe-40hex> <fork-manifest-sha256> [<stronk-omp-s1-YYYY.MM.DD.NNNN>]   a git bundle on standard input
#   status <run-id>    fetch <run-id>    cleanup <run-id>
# Exit codes: 0 done, 1 failed, 2 refused, 3 still running (status only).
set -eu
# The loader reads this file's embedded Python from "#PY" to the end; -I ignores PYTHON* and user site folders.
exec python3 -I -c 'import sys
path = sys.argv[1]
with open(path, encoding="utf-8") as stream:
    text = stream.read()
sys.argv = sys.argv[1:]
exec(compile(text.split("\n#PY\n", 1)[1], path, "exec"), {"__name__": "__main__", "__file__": path})' "$0" "$@"
exit 127
#PY
